# Database Configuration
# You can either provide the full DATABASE_URL connection string:
DATABASE_URL=postgresql://username:password@host:port/database_name

# OR provide individual parameters:
# DB_HOST=your-postgres-host.render.com
# DB_PORT=5432
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_NAME=your_db_name

# CORS Configuration (Set to your Vercel frontend URL in production)
ALLOWED_ORIGINS=http://localhost:5173

# Email Settings (Leave empty to use mock-email preview mode, or fill to send actual emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=induction@dpgu.edu.in
# SMTP_FROM_NAME=DPGU STR Induction Team
